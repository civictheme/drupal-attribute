{
  "name": "drupal-attribute",
  "version": "1.2.2",
  "description": "Emulate Drupal Attribute in JavaScript.",
  "keywords": [
    "drupal"
  ],
  "author": "Eric MORAND <eric.morand@gmail.com>",
  "license": "Apache-2.0",
  "repository": "https://github.com/civictheme/drupal-attribute",
  "main": "src/main/target/index.cjs",
  "module": "src/main/target/index.mjs",
  "types": "src/main/target/index.d.mts",
  "exports": {
    "import": "./src/main/target/index.mjs",
    "require": "./src/main/target/index.cjs",
    "types": "./src/main/target/index.d.mts"
  },
  "files": [
    "src/main/target",
    "src/main/index.mts",
    "src/main/rollup.config.mjs",
    "src/main/tsconfig.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build:main": "(cd src/main && rollup -c)",
    "build:test": "(cd src/test && rollup -c)",
    "prepare": "npm run build:main",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p src/tsconfig.json",
    "test": "npm run build:main && npm run build:test && node src/test/target/index.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nightlycommit/rollup-plugin-package-manifest": "^1.0.0-alpha.2",
    "@types/node": "^16.18.126",
    "@types/tape": "^5.8.1",
    "@types/twig": "^1.12.17",
    "@vitrail/rollup-plugin-typescript": "^1.0.4-beta.0",
    "eslint": "^10.8.0",
    "rollup": "^4.60.3",
    "tape": "^5.9.0",
    "twig": "^1.17.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
